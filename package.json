{
  "name": "xclaude-launcher",
  "version": "0.1.10",
  "description": "Launch Claude Code with reusable environment profiles.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jango26/xclaude-launcher.git"
  },
  "homepage": "https://github.com/Jango26/xclaude-launcher",
  "bugs": {
    "url": "https://github.com/Jango26/xclaude-launcher/issues"
  },
  "keywords": [
    "claude",
    "claude-code",
    "cli",
    "launcher",
    "profiles"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "bin": {
    "xclaude": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "release": "npm version patch --no-git-tag-version && npm run build && npm publish --ignore-scripts"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.5.3",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
